# Copy to .env and fill in. .env is gitignored; this template is not.
# Every value here is optional: the app transcribes without any of them.

# Hugging Face — only needed for speaker diarization, and needed for it either
# way round. The shipped pipeline is gated, and so is the segmentation
# checkpoint the speaker-diarization-3.1 fallback is assembled from:
# pyannote/segmentation-3.0 answered HTTP 401 to an unauthenticated request on
# 2026-09-22. So without a token, or without the conditions accepted at
# https://hf.co/pyannote/speaker-diarization-community-1, a job keeps its whole
# transcript and says on the run that the speakers were skipped and how to fix
# it. Nothing else about transcription changes.
HF_TOKEN=
HUGGINGFACE_TOKEN=

# LLM providers — only needed for summaries, chapters and chat.
# A file or folder pinned "private" refuses every non-local provider outright,
# whatever is set here.
OPENAI_API_KEY=

# OpenRouter: one key, ~423 models including OpenAI, Anthropic and Google.
# Both names are read, OPENROUTER_TOKEN first, and a key set under Settings
# in the app wins over both. A machine-wide environment variable is readable
# by every account on the machine; this file is not, so prefer it.
OPENROUTER_TOKEN=
OPENROUTER_API_KEY=

# Where media, the database, logs and model weights live.
# Defaults to ./data next to this file.
# SCRIBE_DATA_DIR=
